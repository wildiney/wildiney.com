---
import Button from '../ui/Button.astro'
import { getLocalePath, type Locale } from '../../i18n/index'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const heroCopy = {
  pt: {
    label: 'Product & Design Leadership',
    headline: 'Discovery, Strategy & Delivery.',
    sub: 'Conduzo decisões de produto e design, do discovery à entrega, em gov tech, setor financeiro regulado, design systems e IA.',
    cta1: 'Ver contextos de atuação',
    cta2: 'Conversar',
    scroll: 'Role para explorar',
  },
  en: {
    label: 'Product & Design Leadership',
    headline: 'Discovery, Strategy & Delivery.',
    sub: 'I drive product and design decisions, from discovery to delivery, across gov tech, regulated finance, design systems and AI.',
    cta1: 'View case studies',
    cta2: 'Get in touch',
    scroll: 'Scroll to explore',
  },
  es: {
    label: 'Product & Design Leadership',
    headline: 'Discovery, Strategy & Delivery.',
    sub: 'Conduzco decisiones de producto y diseño, del discovery a la entrega, en gov tech, sector financiero regulado, design systems e IA.',
    cta1: 'Ver casos de estudio',
    cta2: 'Conversar',
    scroll: 'Desplázate para explorar',
  },
}
const copy = heroCopy[locale]

const projectsByLocale = {
  pt: [
    {
      num: '01',
      category: 'Gov Tech · Regulatório',
      title: 'App Bolsa Família',
      metric: '+14M de famílias',
      href: `${getLocalePath('pt')}portfolio/globalweb/bolsa-familia/`,
    },
    {
      num: '02',
      category: 'E-commerce · Lançamento',
      title: 'Sanrio Brasil',
      metric: '1º e-commerce Hello Kitty no BR',
      href: `${getLocalePath('pt')}portfolio/sanrio/ecommerce/`,
    },
    {
      num: '03',
      category: 'Enterprise · Internacional',
      title: 'Indra / Minsait',
      metric: '8 anos · Projetos internacionais',
      href: `${getLocalePath('pt')}portfolio/indra/`,
    },
  ],
  en: [
    {
      num: '01',
      category: 'Gov Tech · Regulatory',
      title: 'Bolsa Família App',
      metric: '+14M families',
      href: `${getLocalePath('en')}portfolio/globalweb/bolsa-familia/`,
    },
    {
      num: '02',
      category: 'E-commerce · Launch',
      title: 'Sanrio Brazil',
      metric: '1st Hello Kitty e-commerce in BR',
      href: `${getLocalePath('en')}portfolio/sanrio/ecommerce/`,
    },
    {
      num: '03',
      category: 'Enterprise · International',
      title: 'Indra / Minsait',
      metric: '8 years · International projects',
      href: `${getLocalePath('en')}portfolio/indra/`,
    },
  ],
  es: [
    {
      num: '01',
      category: 'Gov Tech · Regulatorio',
      title: 'App Bolsa Família',
      metric: '+14M de familias',
      href: `${getLocalePath('es')}portfolio/globalweb/bolsa-familia/`,
    },
    {
      num: '02',
      category: 'E-commerce · Lanzamiento',
      title: 'Sanrio Brasil',
      metric: '1º e-commerce Hello Kitty en BR',
      href: `${getLocalePath('es')}portfolio/sanrio/ecommerce/`,
    },
    {
      num: '03',
      category: 'Enterprise · Internacional',
      title: 'Indra / Minsait',
      metric: '8 años · Proyectos internacionales',
      href: `${getLocalePath('es')}portfolio/indra/`,
    },
  ],
}

const projects = projectsByLocale[locale]
---

<section
  class='relative min-h-screen flex items-center bg-dark px-6 md:px-12 lg:px-24 pt-16 overflow-hidden'
>
  <!-- Ambient glow -->
  <div
    class='pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_28%_40%,rgba(77,184,231,0.06)_0%,transparent_70%)]'
    aria-hidden='true'
  >
  </div>

  <div class='relative max-w-5xl mx-auto w-full py-20' data-dissolve>
    <div class='grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-16 items-center'>
      <!-- Left: Intro -->
      <div>
        <p class='text-xs text-accent uppercase tracking-widest mb-6'>
          {copy.label}
        </p>
        <h1
          class='kinetic-heading font-display text-4xl md:text-5xl xl:text-6xl font-black text-dark-text leading-tight mb-6'
        >
          {
            copy.headline.split('\n').map((line, i) =>
              i < copy.headline.split('\n').length - 1 ? (
                <>
                  {line}
                  <br />
                </>
              ) : (
                <>{line}</>
              ),
            )
          }
        </h1>
        <p class='text-muted text-lg leading-relaxed mb-10 max-w-sm'>
          {copy.sub}
        </p>
        <div class='flex flex-wrap gap-4'>
          <Button href='#portfolio' variant='primary'>{copy.cta1}</Button>
          <Button href='#contact' variant='secondary'>{copy.cta2}</Button>
        </div>
      </div>

      <!-- Right: Project cards -->
      <div class='flex flex-col gap-3'>
        {
          projects.map((p) => (
            <a
              href={p.href}
              data-tilt
              class='group flex items-center justify-between border border-dark-border bg-dark-surface px-5 py-4 hover:border-accent/60 hover:-translate-y-0.5 shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] transition-all duration-200'
            >
              <div class='flex items-center gap-4'>
                <span class='text-xs text-accent font-mono tracking-widest'>
                  {p.num}
                </span>
                <div>
                  <p class='text-xs text-muted uppercase tracking-wider mb-1'>
                    {p.category}
                  </p>
                  <p class='text-sm font-semibold text-dark-text group-hover:text-accent transition-colors'>
                    {p.title}
                  </p>
                  {p.metric && (
                    <p class='text-xs text-accent mt-1'>{p.metric}</p>
                  )}
                </div>
              </div>
              <span class='text-muted group-hover:text-accent transition-colors text-lg'>
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class='hidden md:flex flex-col items-center gap-2 mt-16 text-muted'>
      <div class='w-px h-8 bg-accent'></div>
      <p class='text-xs uppercase tracking-widest'>{copy.scroll}</p>
    </div>
  </div>
</section>
